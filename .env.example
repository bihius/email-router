# Optional. `docker compose up -d` works without this file.
# Copy to .env to override the defaults below.

# Routing engine: ollama (LLM agent with tool calling, default) or laya
# (System One decision model). COMPOSE_PROFILES starts the matching optional
# container, so ROUTER_ENGINE is the only line to change.
ROUTER_ENGINE=ollama
COMPOSE_PROFILES=${ROUTER_ENGINE}

OLLAMA_MODEL=qwen3:8b
# qwen3 thinks before it answers. false turns that off: on CPU a ticket then
# takes about 6.5 s instead of about 50 s, and routing is slightly less
# accurate (see eval/README.md). Empty keeps the model's default (thinking).
OLLAMA_THINK=
# Seconds to wait for one Ollama response. The first request also loads the
# model; with qwen3:8b on CPU (Apple M4) that call took about 150 s.
OLLAMA_TIMEOUT=300
# Context window in tokens.
OLLAMA_NUM_CTX=2048
MAIL_FROM=router@example.com

# debug | info | warning | error | critical. info and debug also print the access log.
LOG_LEVEL=warning
# 1 enables Ollama's verbose server log.
OLLAMA_DEBUG=0
