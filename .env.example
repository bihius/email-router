# Optional. `docker compose up -d` works without this file.
# Copy to .env only to override the defaults below.

OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=180
OLLAMA_NUM_CTX=2048
OLLAMA_BASE_URL=http://localhost:11434

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=router@example.com

# API log verbosity: debug, info, warning, error, critical.
# warning and stricter hide the one-line access log. Ollama's extra trace is OLLAMA_DEBUG=1.
LOG_LEVEL=warning
OLLAMA_DEBUG=0
